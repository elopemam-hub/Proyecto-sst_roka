# ── Sistema operativo ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDEs ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Node / Frontend (desarrollo) ─────────────────────────────
frontend/node_modules/
# frontend/dist/ → NO ignorar: se commitea para deploy en Hostinger

# ── Laravel (secretos y archivos generados) ──────────────────
laravel-app/.env
laravel-app/.env.*
laravel-app/vendor/
laravel-app/storage/logs/*.log
laravel-app/storage/framework/cache/data/*
laravel-app/storage/framework/sessions/*
laravel-app/storage/framework/views/*
laravel-app/bootstrap/cache/*.php
laravel-app/public/storage
laravel-app/public/hot
laravel-app/node_modules/

# ── Salida del deploy local a XAMPP ──────────────────────────
# laravel-app/public/ es el DocumentRoot local: recibe una copia de
# frontend/dist/ en cada build. Es output regenerable, no fuente.
# Producción NO usa esta carpeta (usa public_html/sst/ + frontend/dist/).
# index.php, .htaccess, robots.txt, logos y opcache-reset.php SÍ se versionan.
laravel-app/public/assets/
laravel-app/public/index.html
laravel-app/public/sw.js
laravel-app/public/registerSW.js
laravel-app/public/workbox-*.js
laravel-app/public/manifest.webmanifest

# ── Deploy temporal ───────────────────────────────────────────
deploy/hostinger/dist_deploy/
PARA_SUBIR/*.zip
frontend_upload.zip

# ── Composer local ────────────────────────────────────────────
composer.phar
composer-setup.php

# ── Docker y scripts de inicio Windows ───────────────────────
docker-compose.yml
iniciar_*.bat
iniciar_*.ps1
iniciar_*.vbs
{backend,frontend}

# ── Carpeta duplicada / obsoleta ──────────────────────────────
backend/
deploy/hostinger/env_produccion

# ── Archivos temporales de desarrollo ────────────────────────
laravel-app/tmp_test.php
laravel-app/sincronizar_epps_trabajadores.php
laravel-app/check_*.php
verificar-qr.html
VERIFICAR_QR.bat

# ── Carpetas de build duplicadas en raíz (no son el deploy) ──
/public_html/
/public/
