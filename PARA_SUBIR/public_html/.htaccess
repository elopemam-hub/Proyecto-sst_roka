# ============================================================
# SST ROKA — public_html/.htaccess
# ============================================================

# Requerido por Hostinger/LiteSpeed para mod_rewrite
Options -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Pasar el header Authorization a PHP (necesario para Sanctum)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # No reescribir archivos o directorios reales
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Todo lo demás → React SPA (index.html)
    RewriteRule ^ /index.html [L]
</IfModule>

# ── MIME Types (crítico para ES Modules y CSS) ───────────────
<IfModule mod_mime.c>
    AddType text/css                  .css
    AddType application/javascript    .js .mjs
    AddType text/javascript           .js .mjs
    AddType image/png                 .png
    AddType image/svg+xml             .svg
    AddType font/woff2                .woff2
    AddType application/manifest+json .webmanifest
</IfModule>

# ── Cabeceras CORS para assets ───────────────────────────────
<IfModule mod_headers.c>
    <FilesMatch "\.(js|mjs|css|woff2|png|svg)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>
</IfModule>

# ── Compresión GZIP ──────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ── Cache de assets estáticos ────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                 "access plus 1 year"
    ExpiresByType application/javascript   "access plus 1 year"
    ExpiresByType image/png                "access plus 1 month"
    ExpiresByType image/svg+xml            "access plus 1 month"
    ExpiresByType font/woff2               "access plus 1 year"
</IfModule>
